.mx_Pill {
    padding: 3px 6px;
    line-height: $font-17px;
    border-radius: 4px;
    vertical-align: text-top;
    display: inline-block;
    box-sizing: border-box;
    max-width: 100%;
    overflow: hidden;
    cursor: pointer;
    font-weight: 500;

    color: $pill-text-color !important; /* To override .markdown-body */
    background-color: $pill-bg-color !important; /* To override .markdown-body */
    box-shadow: inset 0 0 0 1px $pill-hover-bg-color;

    > * {
        pointer-events: none;
    }

    .mx_BaseAvatar {
        display: none;
    }

    &.mx_UserPill_me,
    &.mx_AtRoomPill,
    &.mx_KeywordPill {
        background-color: $pill-critical-bg-color !important; /* To override .markdown-body */
        color: $pill-critical-text-color !important; /* To override .markdown-body */
        box-shadow: inset 0 0 0 1px $pill-critical-hover-bg-color;
    }

    &:hover {
        background-color: $pill-hover-bg-color !important; /* To override .markdown-body */
    }

    &:active {
        background-color: $pill-press-bg-color !important; /* To override .markdown-body */
    }

    &.mx_UserPill_me:hover {
        background-color: $pill-critical-hover-bg-color !important; /* To override .markdown-body */
    }

    /* We don't want to indicate clickability */
    &.mx_AtRoomPill:hover,
    &.mx_KeywordPill:hover {
        background-color: $pill-critical-hover-bg-color !important; /* To override .markdown-body */
        cursor: unset;
    }

    &.mx_UserPill_me:active,
    &.mx_AtRoomPill:active,
    &.mx_KeywordPill:active {
        background-color: $pill-critical-hover-bg-color !important; /* To override .markdown-body */
    }

    .mx_Pill_text {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    a& {
        text-overflow: ellipsis;
        white-space: nowrap;
        overflow: hidden;
        text-decoration: none !important; /* To override .markdown-body */
    }

    .mx_Pill_LinkIcon {
        background-color: $link-external;
        box-sizing: border-box;
        color: $background;
        height: 16px;
        padding: 1px;
        width: 16px;
        border-radius: 50%;
    }

    .mx_Pill_UserIcon {
        box-sizing: border-box;
        color: $secondary-content;
        height: 16px;
        width: 16px;
    }

    &.mx_SpacePill {
        border-top-left-radius: 8px;
        border-bottom-left-radius: 8px;
        padding-left: 4px;
    }
}
