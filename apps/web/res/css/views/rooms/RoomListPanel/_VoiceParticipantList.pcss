/* Wrapper that stacks the room button + participant list vertically */
.mx_ChannelListItem_wrapper {
    display: flex;
    flex-direction: column;
}

/* Vertical list of voice participants below a channel tile */
.mx_VoiceParticipantList {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-0-5x);
    padding-left: var(--cpd-space-4x);
    padding-right: var(--cpd-space-2x);
    padding-bottom: var(--cpd-space-1x);
}

/* Individual participant row: avatar with ring + name */
.mx_VoiceParticipantRow {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-1-5x);
    padding: var(--cpd-space-1x) var(--cpd-space-2x);
    border-radius: 6px;
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;

    &:hover {
        background-color: var(--cpd-color-bg-action-secondary-hovered);
        color: var(--cpd-color-text-primary);
    }
}


.mx_VoiceParticipantRow_name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
}

/* "+N more" overflow text */
.mx_VoiceParticipantList_overflow {
    padding: 0 var(--cpd-space-2x);
    height: 24px;
    display: flex;
    align-items: center;
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-xs-regular);
    font-style: italic;
}
