/* Wrapper that stacks the room button + participant list vertically */
.mx_ChannelListItem_wrapper {
    display: flex;
    flex-direction: column;
}

/* Vertical list of voice participants below a channel tile */
.mx_VoiceParticipantList {
    display: flex;
    flex-direction: column;
    /* Subtle sub-indent: 8px more than the channel item's 16px */
    padding-left: var(--cpd-space-6x);
    padding-right: var(--cpd-space-3x);
    padding-bottom: var(--cpd-space-1x);
}

/* Individual participant row: avatar + name + green indicator */
.mx_VoiceParticipantRow {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-1x);
    height: 28px;
    padding: 0 var(--cpd-space-1x);
    border-radius: 4px;
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
    transition: background-color 0.1s ease;

    &:hover {
        background-color: var(--cpd-color-bg-action-secondary-hovered);
    }
}

.mx_VoiceParticipantRow_name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
}

/* Green "connected" indicator dot */
.mx_VoiceParticipantRow_indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    background-color: var(--cpd-color-icon-success-primary);
}

/* "+N more" overflow text */
.mx_VoiceParticipantList_overflow {
    padding: 0 var(--cpd-space-1x);
    height: 24px;
    display: flex;
    align-items: center;
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-xs-regular);
    font-style: italic;
}
