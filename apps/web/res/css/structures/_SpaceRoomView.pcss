.mx_SpaceRoomView {
    --innerWidth: 428px;

    overflow-y: auto;
    flex: 1;

    .mx_MainSplit > div:first-child {
        padding: 80px 60px;
        flex-grow: 1;
        max-height: 100%;
        overflow-y: auto;

        h1 {
            margin: 0;
            font-size: $font-24px;
            font-weight: var(--cpd-font-weight-semibold);
            color: $primary-content;
            width: max-content;
        }

        .mx_SpaceRoomView_description {
            font-size: $font-15px;
            color: $secondary-content;
            margin-top: 12px;
            margin-bottom: 24px;
            max-width: var(--innerWidth);
        }

        .mx_AddExistingToSpace {
            max-width: var(--innerWidth);

            .mx_AddExistingToSpace_content {
                height: calc(100vh - 360px);
                max-height: 400px;
            }
        }

        .mx_SpaceRoomView_buttons {
            display: block;
            margin-top: 44px;
            width: var(--innerWidth);
            text-align: right; /* button alignment right */

            .mx_AccessibleButton_hasKind {
                padding: 8px 22px;
                margin-left: 16px;
            }

            input.mx_AccessibleButton {
                border: none; /* override default styles */
            }
        }

        .mx_Field {
            max-width: var(--innerWidth);

            & + .mx_Field {
                margin-top: 28px;
            }
        }

        .mx_SpaceRoomView_errorText {
            font-weight: var(--cpd-font-weight-semibold);
            font-size: $font-12px;
            line-height: $font-15px;
            color: $alert;
            margin-bottom: 28px;
        }

        .mx_AccessibleButton_disabled {
            cursor: not-allowed;
        }
    }

    .mx_SpaceRoomView_landing {
        display: flex;
        flex-direction: column;
        min-width: 0;
        gap: 24px;

        .mx_SpaceRoomView_landing_hero {
            background: $system;
            border: 1px solid $separator;
            border-radius: 16px;
            padding: 28px;
        }

        .mx_SpaceRoomView_landing_hero_header {
            display: flex;
            align-items: center;
            gap: 20px;

            .mx_BaseAvatar {
                flex-shrink: 0;
                border-radius: 12px;
            }
        }

        .mx_SpaceRoomView_landing_hero_info {
            flex: 1;
            min-width: 0;

            h1 {
                margin: 0;
                font-size: $font-24px;
                font-weight: var(--cpd-font-weight-semibold);
                color: $primary-content;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                width: auto;
            }

            .mx_RoomInfoLine {
                margin-top: 4px;
            }
        }

        .mx_SpaceRoomView_landing_hero_actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;

            .mx_SpaceRoomView_landing_inviteButton,
            .mx_SpaceRoomView_landing_settingsButton {
                position: relative;

                svg {
                    position: absolute;
                }
            }

            .mx_SpaceRoomView_landing_inviteButton {
                padding: 4px 18px 4px 40px;
                height: min-content;

                svg {
                    left: 8px;
                    height: 16px;
                    width: 16px;
                    color: var(--cpd-color-icon-on-solid-primary);
                }
            }

            .mx_SpaceRoomView_landing_settingsButton {
                width: 32px;
                height: 32px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 8px;
                transition: background 0.15s ease;

                &:hover {
                    background: $panel-actions;
                }

                svg {
                    position: static;
                    height: 20px;
                    width: 20px;
                    color: $tertiary-content;
                }
            }
        }

        .mx_SpaceRoomView_landing_topic {
            font-size: $font-15px;
            color: $secondary-content;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid $separator;
            white-space: pre-wrap;
            word-wrap: break-word;
            line-height: 1.5;

            &:empty {
                display: none;
            }
        }

        .mx_SpaceRoomView_landing_hero_members {
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid $separator;

            &:empty {
                display: none;
            }

            .mx_FacePile {
                display: inline-flex;
                cursor: pointer;
                outline: 1px solid transparent;
            }
        }

        .mx_SearchBox {
            margin: 0 0 20px;
            flex: 0;
        }
    }

    .mx_SpaceRoomView_inviteTeammates {
        .mx_SpaceRoomView_inviteTeammates_buttons {
            color: $secondary-content;
            margin-top: 28px;

            .mx_AccessibleButton {
                position: relative;
                display: inline-block;
                padding-left: 32px;
                line-height: 24px; /* to center icons */
                color: var(--cpd-color-text-primary);
                font-weight: var(--cpd-font-weight-semibold);
                text-decoration: underline;

                svg {
                    position: absolute;
                    height: 24px;
                    width: 24px;
                    top: 0;
                    left: 0;
                    color: var(--cpd-color-icon-primary);
                }

                & + .mx_AccessibleButton {
                    margin-left: 32px;
                }
            }
        }
    }
}
