.mx_SpaceRoomView_landing {
    .mx_AccessibleButton_kind_link {
        font-size: inherit;
    }

    /* ───── Search ───── */

    .mx_SearchBox {
        margin: 0 0 var(--cpd-space-4x);
    }

    /* Wrapper: transparent background + positioned for icon pseudo-element */
    .mx_textinput {
        background-color: transparent;
        border: none;
        position: relative;

        /* Themed search icon via mask-image so it inherits theme colors */
        &::before {
            content: "";
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 18px;
            height: 18px;
            background-color: $tertiary-content;
            mask-image: url("@vector-im/compound-design-tokens/icons/search.svg");
            mask-size: contain;
            mask-repeat: no-repeat;
            mask-position: center;
            -webkit-mask-image: url("@vector-im/compound-design-tokens/icons/search.svg");
            -webkit-mask-size: contain;
            -webkit-mask-repeat: no-repeat;
            -webkit-mask-position: center;
            pointer-events: none;
            z-index: 1;
            transition: background-color 0.15s ease;
        }

        &:focus-within::before {
            background-color: $accent;
        }
    }

    /* Input: strip the old background-image icon, apply themed styling */
    input.mx_textinput_icon {
        background-image: none !important; /* override _common.pcss background-image */
        background-color: $system;
        border: 1px solid $separator;
        border-radius: 12px;
        padding: 10px 14px 10px 38px;
        font: var(--cpd-font-body-md-regular);
        color: $primary-content;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;

        &:focus {
            border-color: $accent;
            box-shadow: 0 0 0 2px var(--cpd-color-bg-accent-selected);
            outline: none;
        }

        &::placeholder {
            color: $tertiary-content;
        }
    }

    /* ───── No Results ───── */

    .mx_SpaceHierarchy_noResults {
        text-align: center;
        padding: var(--cpd-space-10x) var(--cpd-space-6x);
        background: $system;
        border: 1px solid $separator;
        border-radius: 12px;

        > h3 {
            color: $primary-content;
            margin-bottom: var(--cpd-space-2x);
        }

        > div {
            font-size: $font-15px;
            line-height: $font-24px;
            color: $secondary-content;
        }
    }

    /* ───── List Header ───── */

    .mx_SpaceHierarchy_listHeader {
        display: flex;
        flex-flow: wrap;
        justify-content: space-between;
        align-items: center;
        gap: var(--cpd-space-3x);
        font-size: $font-15px;
        line-height: $font-24px;
        color: $primary-content;
        margin-bottom: var(--cpd-space-4x);
        padding-bottom: var(--cpd-space-4x);
        border-bottom: 1px solid $separator;

        .mx_SpaceHierarchy_listHeader_header {
            font-weight: var(--cpd-font-weight-semibold);
            margin: 0;
        }

        .mx_SpaceHierarchy_listHeader_buttons {
            display: flex;
            flex-flow: wrap;
            gap: 12px;
            min-height: 32px;

            .mx_AccessibleButton {
                padding: 4px 14px;
                font-weight: normal;
                border-radius: 8px;
            }
        }

        .mx_AccessibleButton_kind_danger_outline,
        .mx_AccessibleButton_kind_primary_outline {
            padding: 3px 14px;
        }
    }

    /* ───── Error ───── */

    .mx_SpaceHierarchy_error {
        position: relative;
        font-weight: var(--cpd-font-weight-semibold);
        color: $alert;
        font-size: $font-15px;
        line-height: $font-18px;
        margin: 20px auto 12px;
        padding-left: 24px;
        width: max-content;

        &::before {
            content: "";
            position: absolute;
            height: 16px;
            width: 16px;
            left: 0;
            background-image: url("@vector-im/compound-design-tokens/icons/error-solid.svg");
            background-size: cover;
            background-repeat: no-repeat;
        }
    }

    /* ───── Room Count ───── */

    .mx_SpaceHierarchy_roomCount {
        > h3 {
            display: inline;
            font-weight: var(--cpd-font-weight-semibold);
            font-size: $font-18px;
            line-height: $font-22px;
            color: $primary-content;
        }

        > span {
            margin-left: 8px;
            font-size: $font-15px;
            line-height: $font-24px;
            color: $secondary-content;
        }
    }

    /* ───── Subspace Toggle ───── */

    .mx_SpaceHierarchy_subspace_toggle {
        position: absolute;
        left: -1px;
        top: 50%;
        transform: translateY(-50%);
        height: 24px;
        width: 24px;
        border-radius: 6px;
        background-color: transparent;
        transition: background-color 0.15s ease;

        &:hover {
            background-color: $panel-actions;
        }

        svg {
            width: 22px;
            height: 22px;
            color: $tertiary-content;
            transform: rotate(270deg);
            transition: transform 0.2s ease, color 0.15s ease;
        }

        &.mx_SpaceHierarchy_subspace_toggle_shown svg {
            transform: rotate(0deg);
            color: $accent;
        }
    }

    /* ───── Children Container ───── */

    .mx_SpaceHierarchy_subspace_children {
        position: relative;
        padding: 4px 4px 4px 20px;
        margin-left: 14px;
        border-left: 2px solid $accent;

        /* Override: no tree connector ::before on children container */
        &::before {
            display: none;
        }
    }

    /* ───── Room List ───── */

    .mx_SpaceHierarchy_list {
        list-style: none;
        padding: 0;
        margin: 0;

        li.mx_SpaceHierarchy_roomTileWrapper {
            list-style: none;

            & + li.mx_SpaceHierarchy_roomTileWrapper {
                margin-top: 2px;
            }

            /* ─── Base tile ─── */
            .mx_SpaceHierarchy_roomTile {
                position: relative;
                padding: var(--cpd-space-3x) var(--cpd-space-4x);
                border-radius: 12px;
                border: 1px solid transparent;
                box-sizing: border-box;
                min-height: 52px;
                transition: background-color 0.15s ease, border-color 0.15s ease;

                display: flex;
                flex-wrap: wrap;
                gap: var(--cpd-space-1-5x) var(--cpd-space-3x);

                /* No tree connector line on tiles */
                &::before {
                    display: none;
                }

                /* ─ Grid layout for room info ─ */
                .mx_SpaceHierarchy_roomTile_item {
                    font-weight: var(--cpd-font-weight-semibold);
                    font-size: $font-15px;
                    line-height: $font-18px;
                    display: grid;
                    grid-template-columns: 36px auto;
                    gap: var(--cpd-space-1-5x) var(--cpd-space-3x);
                    align-items: center;
                    flex: 1;

                    .mx_SpaceHierarchy_roomTile_avatar {
                        grid-row: 1 / 3;
                        grid-column: 1;
                        align-self: center;

                        img,
                        span {
                            width: 36px !important;
                            height: 36px !important;
                            border-radius: 10px;
                        }
                    }

                    .mx_SpaceHierarchy_roomTile_name {
                        grid-row: 1;
                        grid-column: 2;

                        .mx_InfoTooltip,
                        .mx_SpaceHierarchy_roomTile_joined {
                            margin-left: 12px;
                            font-size: $font-12px;
                            line-height: $font-15px;
                        }

                        .mx_InfoTooltip {
                            display: inline-block;
                            color: $tertiary-content;
                        }

                        .mx_SpaceHierarchy_roomTile_joined {
                            display: inline-flex;
                            align-items: center;
                            vertical-align: middle;
                            gap: 2px;
                            color: $accent;
                            font-weight: var(--cpd-font-weight-semibold);

                            svg {
                                width: 16px;
                                height: 16px;
                                color: $accent;
                            }
                        }
                    }

                    .mx_SpaceHierarchy_roomTile_info {
                        grid-row: 2;
                        grid-column: 2;
                        font: var(--cpd-font-body-md-regular);
                        font-weight: initial;
                        line-height: $font-18px;
                        color: $secondary-content;
                        display: -webkit-box;
                        -webkit-box-orient: vertical;
                        -webkit-line-clamp: 2;
                        overflow: hidden;
                    }
                }

                /* ─ Action buttons ─ */
                .mx_SpaceHierarchy_actions {
                    display: flex;
                    align-items: center;
                    column-gap: 12px;
                    margin-left: auto;

                    .mx_AccessibleButton {
                        line-height: $font-24px;
                        padding: 4px 16px;
                        display: inline-block;
                        border-radius: 8px;
                    }

                    .mx_AccessibleButton_kind_danger_outline,
                    .mx_AccessibleButton_kind_primary_outline {
                        padding: 3px 16px;
                    }
                }

                /* ─ Hover for regular rooms ─ */
                &:hover,
                &:focus-within {
                    background-color: var(--cpd-color-bg-action-secondary-hovered);
                    border-color: $separator;
                }

                &.mx_SpaceHierarchy_joining {
                    .mx_AccessibleButton {
                        padding: 4px 18px;
                    }
                }

                /* ─ Subspace tile: card-like section header ─ */
                &.mx_SpaceHierarchy_subspace {
                    background: $system;
                    border: 1px solid $separator;
                    border-left: 3px solid $accent;
                    border-radius: 12px;
                    min-height: 56px;
                    margin-top: 6px;
                    margin-bottom: 2px;
                    padding-left: var(--cpd-space-5x);

                    &:hover,
                    &:focus-within {
                        background: $system;
                        border-color: $separator;
                        border-left-color: $accent;
                        border-left-width: 3px;
                        box-shadow: var(--zendeus-shadow-sm);
                    }
                }
            }
        }

        /* ─── Children inside subspace: slightly compact ─── */
        .mx_SpaceHierarchy_subspace_children {
            li.mx_SpaceHierarchy_roomTileWrapper {
                & + li.mx_SpaceHierarchy_roomTileWrapper {
                    margin-top: 0;
                }

                .mx_SpaceHierarchy_roomTile:not(.mx_SpaceHierarchy_subspace) {
                    border-radius: 10px;
                    min-height: 48px;
                    padding: var(--cpd-space-2x) var(--cpd-space-3x);

                    .mx_SpaceHierarchy_roomTile_item {
                        grid-template-columns: 32px auto;

                        .mx_SpaceHierarchy_roomTile_avatar {
                            img,
                            span {
                                width: 32px !important;
                                height: 32px !important;
                                border-radius: 8px;
                            }
                        }
                    }
                }
            }
        }
    }

    /* ───── Manage Actions Text ───── */

    .mx_SpaceHierarchy_actions {
        .mx_SpaceHierarchy_actionsText {
            font-weight: normal;
            font-size: $font-12px;
            line-height: $font-15px;
            color: $secondary-content;
        }
    }

    > hr {
        border: none;
        height: 1px;
        background-color: $separator;
        margin: 20px 0;
    }

    .mx_SpaceHierarchy_createRoom {
        display: block;
        margin: 16px auto 0;
        width: max-content;
    }
}
