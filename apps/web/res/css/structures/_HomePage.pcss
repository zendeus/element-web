.mx_HomePage {
    max-width: 960px;
    width: 100%;
    height: 100%;
    margin-left: auto;
    margin-right: auto;
}

.mx_HomePage_default {
    text-align: center;
    display: flex;
    position: relative;

    /* Subtle gradient background matching SplashPage */
    &::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse at 70% 0%, var(--cpd-color-bg-accent-selected) 0%, transparent 60%),
            radial-gradient(ellipse at 30% 100%, var(--cpd-color-bg-accent-selected) 0%, transparent 60%);
        pointer-events: none;
        z-index: 0;
    }

    .mx_HomePage_default_wrapper {
        margin: auto;
        position: relative;
        z-index: 1;
    }

    img {
        height: 48px;
    }

    h1 {
        font: var(--cpd-font-heading-xl-semibold);
        color: var(--cpd-color-text-primary);
        margin-bottom: 4px;
    }

    h2 {
        margin-top: 4px;
        font: var(--cpd-font-body-lg-regular);
        color: var(--cpd-color-text-secondary);
    }

    .mx_MiniAvatarUploader {
        margin: 0 auto;
    }

    .mx_HomePage_default_buttons {
        display: flex;
        margin: 60px auto 0;
        width: fit-content;

        .mx_AccessibleButton {
            padding: 73px 8px 15px; /* top: 20px top padding + 40px icon + 13px margin */

            width: 160px;
            min-height: 132px;
            margin: 12px;
            position: relative;
            display: inline-block;
            border-radius: 12px;
            vertical-align: top;
            word-break: break-word;
            box-sizing: border-box;

            font: var(--cpd-font-body-md-semibold);
            color: var(--cpd-color-text-primary);
            background-color: var(--cpd-color-bg-subtle-primary);
            border: 1px solid var(--cpd-color-border-interactive-secondary);
            box-shadow: var(--zendeus-shadow-sm, 0 2px 8px rgba(0, 0, 0, 0.06));
            transition: background-color 0.15s ease, box-shadow 0.15s ease;

            &:hover {
                background-color: var(--cpd-color-bg-action-secondary-hovered);
                box-shadow: var(--zendeus-shadow-md, 0 4px 16px rgba(0, 0, 0, 0.08));
            }

            svg {
                top: 20px;
                left: 60px; /* (160px-40px)/2 */
                width: 40px;
                height: 40px;
                position: absolute;
                color: var(--cpd-color-icon-accent-primary);
            }
        }
    }
}
