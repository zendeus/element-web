/* Zendeus Light Theme */
/* Clean slate canvas with sky-blue accent */
/* ******************** */

/* Core content colors */
$primary-content: #0F172A;
$secondary-content: #475569;
$tertiary-content: #64748B;
$quaternary-content: #94A3B8;
$quinary-content: #CBD5E1;

/* Backgrounds */
$system: #F1F5F9;
$system-transparent: #F1F5F900;
$background: #F8FAFC;
$overlay-background: rgba(15, 23, 42, 0.5);

$panels: #F1F5F9;
$panel-actions: rgba(14, 165, 233, 0.06);

$separator: #E2E8F0;

/* Accent & links */
$accent: #0EA5E9;
$alert: #DC2626;
$links: #0EA5E9;
$link-external: #0EA5E9;

/* Username colors — expanded cool-tone palette for light bg */
$username-variant1-color: #0284c7;
$username-variant2-color: #4f46e5;
$username-variant3-color: #0d9488;
$username-variant4-color: #7c3aed;
$username-variant5-color: #0891b2;
$username-variant6-color: #9333ea;
/* ******************** */

/**
 * Accent color scale — mapped to sky-blue shades
 */
$accent-100: #f0f9ff;
$accent-200: #e0f2fe;
$accent-300: #bae6fd;
$accent-400: #7dd3fc;
$accent-500: #38bdf8;
$accent-600: #0ea5e9;
$accent-700: #0284c7;
$accent-800: #0369a1;
$accent-900: #075985;
$accent-1000: #0c4a6e;
$accent-1100: #082f49;
$accent-1200: #082f49;
$accent-1300: #0c1524;
$accent-1400: #000000;

/* Reused colors */
/* ******************** */
$inverted-bg-color: #0EA5E9;
$header-panel-bg-color: #F1F5F9;
$header-panel-bg-hover: rgba(14, 165, 233, 0.04);
/* ******************** */

/* Theme specific colors */
/* ******************** */
$icon-button-color: #64748B;
/* ******************** */

/* Colors that aren't in Figma and are theme specific */
/* ******************** */
$selection-fg-color: $background;
$yellow-background: #FEF9C3;
$secondary-accent-color: #F1F5F9;
$button-fg-color: $background;
$neutral-badge-color: #CBD5E1;
$strong-input-border-color: #94A3B8;
$preview-widget-bar-color: #F1F5F9;
$accent-fg-color: #F8FAFC;
$accent-alt: #0EA5E9;
$info-plinth-fg-color: #334155;
/* ******************** */

/* Colors that aren't in Figma */
/* ******************** */
$dark-panel-bg-color: #F1F5F9;
$muted-fg-color: #64748B;
$light-fg-color: #94A3B8;
$focus-bg-color: $preview-widget-bar-color;
$info-plinth-bg-color: #F1F5F9;
$event-selected-color: #F1F5F9;
$topleftmenu-color: #0F172A;
$roomtopic-color: #94A3B8;
$spacePanel-bg-color: rgba(226, 232, 240, 0.77);
$panel-gradient: rgba(248, 250, 252, 0), rgba(248, 250, 252, 1);
$h3-color: #1E293B;
$event-highlight-bg-color: $yellow-background;
$header-panel-text-primary-color: #64748B;
/* ******************** */

/* Blockquote */
/* ******************** */
$blockquote-bar-color: #94A3B8;
/* ******************** */

/* Tooltip */
/* ******************** */
$tooltip-timeline-bg-color: $inverted-bg-color;
$tooltip-timeline-fg-color: $background;
/* ******************** */

/* Widget */
/* ******************** */
$widget-menu-bar-bg-color: $secondary-accent-color;
$widget-body-bg-color: $background;
/* ******************** */

/* Menu */
/* ******************** */
$menu-border-color: #E2E8F0;
$menu-bg-color: $background;
$menu-box-shadow-color: rgba(100, 116, 139, 0.25);
$menu-selected-color: #F1F5F9;
/* ******************** */

/* Settings */
/* ******************** */
$settings-grey-fg-color: #94A3B8;
$settings-subsection-fg-color: $muted-fg-color;
/* ******************** */

/* Room */
/* ******************** */
$room-icon-unread-color: #64748B;
/* ******************** */

/* RoomHeader */
/* ******************** */
$roomheader-addroom-bg-color: rgba(14, 165, 233, 0.1);
$roomheader-addroom-fg-color: #475569;
/* ******************** */

/* Rich-text-editor */
/* ******************** */
$pill-bg-color: #0EA5E9;
$pill-hover-bg-color: #0284C7;
$pill-press-bg-color: #0369A1;
$rte-bg-color: #E2E8F0;
$rte-code-bg-color: rgba(0, 0, 0, 0.04);
/* ******************** */

/* Presence */
/* ******************** */
$presence-away: #d9b072;
$presence-offline: #e3e8f0;
$presence-busy: $alert;
/* ******************** */

/* Inputs */
/* ******************** */
$input-border-color: #E2E8F0;
$input-darker-bg-color: $quinary-content;
$input-darker-fg-color: #94A3B8;
$input-lighter-bg-color: #F1F5F9;
$input-underline-color: rgba(148, 163, 184, 0.5);
$input-fg-color: rgba(15, 23, 42, 0.9);
$input-placeholder: #94A3B8;
/* ******************** */

/* Dialog */
/* ******************** */
$dialog-title-fg-color: $primary-content;
$dialog-backdrop-color: #0F172A4D;
$dialog-close-fg-color: $icon-button-color;
$dialog-close-external-color: $background;
/* ******************** */

/* ImageBody */
/* ******************** */
$imagebody-giflabel: rgba(0, 0, 0, 0.7);
$imagebody-giflabel-border: rgba(0, 0, 0, 0.2);
$imagebody-giflabel-color: $accent-fg-color;
/* ******************** */

/* RoomList */
/* ******************** */
$roomlist-bg-color: rgba(241, 245, 249, 0.9);
$roomsublist-skeleton-ui-bg: linear-gradient(180deg, $background 0%, #ffffff00 100%);
$roomtile-default-badge-bg-color: #64748B;
/* ******************** */

/* e2e */
/* ******************** */
$e2e-verified-color: #16A34A;
$e2e-warning-color: #DC2626;
$e2e-verified-color-light: #BBF7D0;
$e2e-warning-color-light: #FECACA;
/* ******************** */

/* Tabbed views */
/* ******************** */
$tab-label-fg-color: $secondary-content;
$tab-label-active-fg-color: $primary-content;
/* ******************** */

/* Buttons */
/* ******************** */
$button-primary-fg-color: #FFFFFF;
$button-secondary-bg-color: $accent-fg-color;
$button-danger-fg-color: #FFFFFF;
$button-danger-disabled-fg-color: #FFFFFF;
$button-danger-disabled-bg-color: #FECACA;
/* ******************** */

/* Toggle switch */
/* ******************** */
$togglesw-off-color: #CBD5E1;
$togglesw-ball-color: #0EA5E9;
/* ******************** */

/* Authpage */
/* ******************** */
$authpage-primary-color: #0F172A;
$authpage-bg-color: #1E293B;
$authpage-modal-bg-color: $roomlist-bg-color;
$authpage-modal-content-with-blur-bg-color: rgb(255, 255, 255, 0.59);
$authpage-focus-bg-color: $focus-bg-color;
$authpage-lang-color: $secondary-content;
$authpage-secondary-color: $secondary-content;
/* ******************** */

/* Message action bar */
/* ******************** */
$message-action-bar-bg-color: $background;
$message-action-bar-fg-color: $primary-content;
$message-action-bar-border-color: #E2E8F0;
$message-action-bar-hover-border-color: $focus-bg-color;
/* ******************** */

/* Reaction row */
/* ******************** */
$reaction-row-button-hover-border-color: $focus-bg-color;
$reaction-row-button-selected-bg-color: #e0f2fe;
/* ******************** */

/* Voice messages */
/* ******************** */
$voice-record-stop-symbol-color: #ff5b55;
$voice-record-live-circle-color: #ff5b55;
$voice-record-stop-border-color: $quinary-content;
$voice-record-icon-color: $tertiary-content;
/* ******************** */

/* Bubble tiles */
/* ******************** */
$eventbubble-self-bg: #e0f2fe;
$eventbubble-others-bg: #F1F5F9;
$eventbubble-bg-hover: #E2E8F0;
/* ******************** */

/* Lightbox */
/* ******************** */
$lightbox-fg-color: #fff;
$lightbox-background-bg-color: #000;
$lightbox-background-bg-opacity: 0.95;
/* ******************** */

/* VoIP */
/* ******************** */
$call-view-button-on-foreground: $secondary-content;
$call-view-button-on-background: $background;
$call-view-button-off-foreground: $background;
$call-view-button-off-background: $secondary-content;
$call-view-content-background: #1E293B;

$video-feed-secondary-background: #334155;
$voipcall-plinth-color: $system;

$call-system: #1E293B;
$call-background: #0F172A;
$call-primary-content: #ffffff;
$call-light-quaternary-content: #94A3B8;
/* ******************** */

/* One-off global colors */
/* ******************** */
$pinned-color: $tertiary-content;
$avatar-initial-color: $background;
$primary-hairline-color: #E2E8F0;
$secondary-hairline-color: #E2E8F0;
$focus-brightness: 105%;
/* ******************** */

/* Avatar background colors for canvas fallback (pills, mentions) */
/* ******************** */
:root {
    --avatar-background-colors_1: #e0f2fe;
    --avatar-background-colors_2: #e0e7ff;
    --avatar-background-colors_3: #ccfbf1;
    --avatar-background-colors_4: #ede9fe;
    --avatar-background-colors_5: #cffafe;
    --avatar-background-colors_6: #fae8ff;
}
/* ******************** */

/* blur amounts for left panel */
/* ******************** */
:root {
    --lp-background-blur: 40px;
}
/* ******************** */

/* Location sharing */
/* ******************** */
$location-marker-color: #FFFFFF;
$location-live-color: #0EA5E9;
$location-live-secondary-color: #7dd3fc;
/* ******************** */

body {
    color-scheme: light;
}

/* Dialog glass border — subtle thin border instead of thick frosted glass */
.mx_Dialog_wrapper .mx_Dialog_border {
    padding: 1px;
    background: $separator;
    outline: none;
    backdrop-filter: none;
    border-radius: 14px;

    /* Override Glass module's inner child radius to match outer - padding */
    > :first-child {
        border-radius: 13px;
    }
}

/* Space button — match selection wrapper radius to avatar curvature */
.mx_SpacePanel .mx_SpaceButton.mx_SpaceButton_narrow .mx_SpaceButton_selectionWrapper {
    border-radius: 11px;
}

/* Splash Page Gradient — sky-blue tinted for light theme */
.mx_SplashPage::before {
    background-image:
        radial-gradient(53.85% 66.75% at 87.55% 0%, hsla(199deg, 89%, 48%, 0.12) 0%, hsla(199deg, 100%, 88%, 0) 100%),
        radial-gradient(41.93% 41.93% at 0% 0%, hsla(215deg, 25%, 40%, 0.1) 0%, hsla(199deg, 100%, 88%, 0) 100%),
        radial-gradient(100% 100% at 0% 0%, hsla(199deg, 89%, 60%, 0.08) 0%, hsla(199deg, 100%, 86%, 0) 100%),
        radial-gradient(106.35% 96.26% at 100% 0%, hsla(199deg, 89%, 48%, 0.12) 0%, hsla(180deg, 76%, 82%, 0) 100%) !important;
}

/* One-off colors */
/* ******************** */
$progressbar-bg-color: #E2E8F0;
$kbd-border-color: $strong-input-border-color;
$visual-bell-bg-color: #faa;
$event-timestamp-color: #94A3B8;
$composer-shadow-color: rgba(0, 0, 0, 0.04);
$breadcrumb-placeholder-bg-color: #E2E8F0;
$resend-button-divider-color: $input-darker-bg-color;
$inlinecode-border-color: $quinary-content;
$inlinecode-background-color: $system;
$codeblock-background-color: $header-panel-bg-color;
$scrollbar-thumb-color: rgba(0, 0, 0, 0.15);
$selected-color: $secondary-accent-color;
/* ******************** */

/* diff highlight colors */
/* ******************** */
.hljs-addition {
    background: #e0f2fe;
}

.hljs-deletion {
    background: #fecaca;
}
/* ******************** */

/* ******************** */
/* Compound Design Token Overrides */
/* Override the --cpd-color-* CSS custom properties that Compound components use directly */
/* ******************** */
@layer compound.custom {
    :root, [class*="cpd-theme-"] {
        /* Gray scale — slate-tinted */
        --cpd-color-gray-100: #F8FAFC;
        --cpd-color-gray-200: #F1F5F9;
        --cpd-color-gray-300: #E2E8F0;
        --cpd-color-gray-400: #CBD5E1;
        --cpd-color-gray-500: #94A3B8;
        --cpd-color-gray-600: #64748B;
        --cpd-color-gray-700: #475569;
        --cpd-color-gray-800: #334155;
        --cpd-color-gray-900: #1E293B;
        --cpd-color-gray-1000: #1E293B;
        --cpd-color-gray-1100: #0F172A;
        --cpd-color-gray-1200: #0F172A;
        --cpd-color-gray-1300: #0F172A;
        --cpd-color-gray-1400: #0F172A;

        /* Alpha grays */
        --cpd-color-alpha-gray-100: hsla(215, 20%, 40%, 0.01);
        --cpd-color-alpha-gray-200: hsla(215, 20%, 40%, 0.04);
        --cpd-color-alpha-gray-300: hsla(215, 20%, 40%, 0.06);
        --cpd-color-alpha-gray-400: hsla(215, 20%, 40%, 0.1);
        --cpd-color-alpha-gray-500: hsla(215, 20%, 40%, 0.15);
        --cpd-color-alpha-gray-1300: hsla(215, 25%, 10%, 0.5);

        /* Blue scale — aligned with sky-blue accent */
        --cpd-color-blue-100: #f0f9ff;
        --cpd-color-blue-200: #e0f2fe;
        --cpd-color-blue-300: #bae6fd;
        --cpd-color-blue-400: #7dd3fc;
        --cpd-color-blue-500: #38bdf8;
        --cpd-color-blue-600: #0ea5e9;
        --cpd-color-blue-700: #0284c7;
        --cpd-color-blue-800: #0369a1;
        --cpd-color-blue-900: #0EA5E9;
        --cpd-color-blue-1000: #0284c7;
        --cpd-color-blue-1100: #0369a1;
        --cpd-color-blue-1200: #075985;
        --cpd-color-blue-1300: #0c4a6e;
        --cpd-color-blue-1400: #082f49;

        /* Green scale — remapped to sky-blue */
        --cpd-color-green-100: #f0f9ff;
        --cpd-color-green-200: #e0f2fe;
        --cpd-color-green-300: #bae6fd;
        --cpd-color-green-400: #7dd3fc;
        --cpd-color-green-500: #38bdf8;
        --cpd-color-green-600: #0ea5e9;
        --cpd-color-green-700: #0284c7;
        --cpd-color-green-800: #0369a1;
        --cpd-color-green-900: #0EA5E9;
        --cpd-color-green-1000: #0284c7;
        --cpd-color-green-1100: #0369a1;
        --cpd-color-green-1200: #075985;
        --cpd-color-green-1300: #0c4a6e;
        --cpd-color-green-1400: #082f49;

        /* Alpha greens — remapped to sky-blue with alpha */
        --cpd-color-alpha-green-100: hsla(199, 89%, 48%, 0.02);
        --cpd-color-alpha-green-200: hsla(199, 89%, 48%, 0.05);
        --cpd-color-alpha-green-300: hsla(199, 89%, 48%, 0.08);
        --cpd-color-alpha-green-400: hsla(199, 89%, 48%, 0.12);
        --cpd-color-alpha-green-500: hsla(199, 89%, 48%, 0.18);

        /* Red scale — clean red for light theme */
        --cpd-color-red-100: #FEF2F2;
        --cpd-color-red-200: #FEE2E2;
        --cpd-color-red-300: #FECACA;
        --cpd-color-red-400: #FCA5A5;
        --cpd-color-red-500: #F87171;
        --cpd-color-red-600: #EF4444;
        --cpd-color-red-700: #DC2626;
        --cpd-color-red-800: #B91C1C;
        --cpd-color-red-900: #DC2626;
        --cpd-color-red-1000: #B91C1C;
        --cpd-color-red-1100: #991B1B;
        --cpd-color-red-1200: #7F1D1D;
        --cpd-color-red-1300: #601010;
        --cpd-color-red-1400: #450A0A;

        /* Background tokens */
        --cpd-color-theme-bg: #F8FAFC;
        --cpd-color-bg-canvas-default: #F8FAFC;
        --cpd-color-bg-subtle-primary: #F1F5F9;
        --cpd-color-bg-subtle-secondary: #E2E8F0;
        --cpd-color-bg-action-primary-rest: #0EA5E9;
        --cpd-color-bg-action-primary-hovered: #0284C7;
        --cpd-color-bg-action-primary-pressed: #0369A1;
        --cpd-color-bg-action-secondary-rest: #F8FAFC;
        --cpd-color-bg-action-secondary-hovered: rgba(14, 165, 233, 0.06);
        --cpd-color-bg-action-tertiary-hovered: #E2E8F0;
        --cpd-color-bg-action-tertiary-selected: #CBD5E1;
        --cpd-color-bg-accent-rest: #0EA5E9;
        --cpd-color-bg-accent-hovered: #0284C7;
        --cpd-color-bg-accent-pressed: #0369A1;
        --cpd-color-bg-accent-selected: hsla(199, 89%, 48%, 0.08);
        --cpd-color-bg-success-subtle: #e0f2fe;
        --cpd-color-bg-critical-primary: #DC2626;
        --cpd-color-bg-critical-hovered: #B91C1C;
        --cpd-color-bg-critical-subtle: #FEE2E2;
        --cpd-color-bg-critical-subtle-hovered: #FECACA;
        --cpd-color-bg-info-subtle: #e0f2fe;
        --cpd-color-bg-badge-accent: hsla(199, 89%, 48%, 0.12);

        /* Text tokens */
        --cpd-color-text-primary: #0F172A;
        --cpd-color-text-secondary: #475569;
        --cpd-color-text-action-accent: #0EA5E9;
        --cpd-color-text-link-external: #0EA5E9;
        --cpd-color-text-critical-primary: #DC2626;
        --cpd-color-text-success-primary: #0EA5E9;
        --cpd-color-text-info-primary: #0EA5E9;
        --cpd-color-text-on-solid-primary: #FFFFFF;
        --cpd-color-text-badge-accent: #0369a1;

        /* Icon tokens */
        --cpd-color-icon-primary: #0F172A;
        --cpd-color-icon-secondary: #475569;
        --cpd-color-icon-tertiary: #64748B;
        --cpd-color-icon-on-solid-primary: #FFFFFF;
        --cpd-color-icon-success-primary: #0EA5E9;
        --cpd-color-icon-critical-primary: #DC2626;
        --cpd-color-icon-accent-tertiary: #0EA5E9;
        --cpd-color-icon-accent-primary: #0EA5E9;

        /* Border tokens */
        --cpd-color-border-interactive-primary: #94A3B8;
        --cpd-color-border-interactive-secondary: #CBD5E1;
        --cpd-color-border-interactive-hovered: #64748B;
        --cpd-color-border-disabled: #E2E8F0;
        --cpd-color-border-success-subtle: #38bdf8;
        --cpd-color-border-accent-subtle: #0284c7;
        --cpd-color-border-critical-primary: #DC2626;
        --cpd-color-border-critical-hovered: #B91C1C;
        --cpd-color-border-critical-subtle: #F87171;

        /* Focus border — aligned with sky-blue */
        --cpd-color-border-focused: #0EA5E9;

        /* Gradient tokens — subtle, theme-fitting gradients */
        --cpd-color-gradient-critical-stop1: rgba(220, 38, 38, 0.06);
        --cpd-color-gradient-critical-stop2: var(--cpd-color-theme-bg);
        --cpd-color-gradient-critical-linear: linear-gradient(180deg, rgba(220, 38, 38, 0.06) 0%, var(--cpd-color-theme-bg) 100%);
        --cpd-color-gradient-info-stop1: rgba(14, 165, 233, 0.06);
        --cpd-color-gradient-info-stop2: var(--cpd-color-theme-bg);
        --cpd-color-gradient-info-linear: linear-gradient(180deg, rgba(14, 165, 233, 0.06) 0%, var(--cpd-color-theme-bg) 100%);

        /* Shadow elevation tokens — subtle on light backgrounds */
        --zendeus-shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.06);
        --zendeus-shadow-md: 0 4px 16px rgba(15, 23, 42, 0.08);
        --zendeus-shadow-lg: 0 8px 32px rgba(15, 23, 42, 0.12);

        /* Username / decorative colors — expanded cool-tone palette for light bg */
        --cpd-color-text-decorative-1: #0284c7;
        --cpd-color-text-decorative-2: #4f46e5;
        --cpd-color-text-decorative-3: #0d9488;
        --cpd-color-text-decorative-4: #7c3aed;
        --cpd-color-text-decorative-5: #0891b2;
        --cpd-color-text-decorative-6: #9333ea;

        /* Avatar background colors — light pastels matching the text decorative palette */
        --cpd-color-bg-decorative-1: #e0f2fe;
        --cpd-color-bg-decorative-2: #e0e7ff;
        --cpd-color-bg-decorative-3: #ccfbf1;
        --cpd-color-bg-decorative-4: #ede9fe;
        --cpd-color-bg-decorative-5: #cffafe;
        --cpd-color-bg-decorative-6: #fae8ff;
    }
}
