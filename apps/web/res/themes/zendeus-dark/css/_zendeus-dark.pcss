/* Zendeus Dark Theme */
/* Deep navy canvas with sky-blue accent */
/* ******************** */

/* Core content colors */
$primary-content: #E2E8F0;
$secondary-content: #94A3B8;
$tertiary-content: #64748B;
$quaternary-content: #475569;
$quinary-content: #334155;

/* Backgrounds */
$system: #1E1E2A;
$system-transparent: #1E1E2A00;
$background: #0C0C12;
$overlay-background: rgba(0, 0, 0, 0.75);

$panels: #1E1E2A;
$panel-actions: rgba(56, 189, 248, 0.08);

$separator: #2a2a3a;

/* Accent & links */
$accent: #38BDF8;
$alert: #F87171;
$links: #38BDF8;
$link-external: #38BDF8;

/* Username colors — blue/steel/gray analogous palette */
$username-variant1-color: #7DD3FC;
$username-variant2-color: #93C5FD;
$username-variant3-color: #A5B4FC;
$username-variant4-color: #BAE6FD;
$username-variant5-color: #CBD5E1;
$username-variant6-color: #67E8F9;
/* ******************** */

/**
 * Accent color scale — mapped to sky-blue shades
 */
$accent-100: #082f49;
$accent-200: #0c4a6e;
$accent-300: #075985;
$accent-400: #0369a1;
$accent-500: #0284c7;
$accent-600: #0ea5e9;
$accent-700: #38bdf8;
$accent-800: #7dd3fc;
$accent-900: #bae6fd;
$accent-1000: #e0f2fe;
$accent-1100: #f0f9ff;
$accent-1200: #f0f9ff;
$accent-1300: #f8fafc;
$accent-1400: #ffffff;

/* Reused colors */
/* ******************** */
$inverted-bg-color: #38BDF8;
$header-panel-bg-color: #1E1E2A;
$header-panel-bg-hover: #2a2a3a;
/* ******************** */

/* Theme specific colors */
/* ******************** */
$icon-button-color: #64748B;
/* ******************** */

/* Colors that aren't in Figma and are theme specific */
/* ******************** */
$header-panel-text-secondary-color: #94A3B8;
$room-highlight-color: #2a2a3a;
$text-secondary-color: #94A3B8;
/* ******************** */

/* Colors that aren't in Figma */
/* ******************** */
$dark-panel-bg-color: #1E1E2A;
$muted-fg-color: #94A3B8;
$light-fg-color: #64748B;
$focus-bg-color: $room-highlight-color;
$info-plinth-bg-color: $header-panel-bg-color;
$event-selected-color: #1E1E2A;
$topleftmenu-color: $primary-content;
$roomtopic-color: $text-secondary-color;
$spacePanel-bg-color: rgba(12, 12, 18, 0.82);
$panel-gradient: rgba(12, 12, 18, 0), rgba(12, 12, 18, 1);
$h3-color: $primary-content;
$event-highlight-bg-color: #1a1a2e;
$header-panel-text-primary-color: $text-secondary-color;
/* ******************** */

/* Tooltip */
/* ******************** */
$tooltip-timeline-bg-color: $spacePanel-bg-color;
$tooltip-timeline-fg-color: $primary-content;
/* ******************** */

/* Widget */
/* ******************** */
$widget-menu-bar-bg-color: $header-panel-bg-color;
$widget-body-bg-color: $panel-actions;
/* ******************** */

/* Menu */
/* ******************** */
$menu-border-color: #000000;
$menu-bg-color: $header-panel-bg-color;
$menu-box-shadow-color: $background;
$menu-selected-color: $room-highlight-color;
/* ******************** */

/* Settings */
/* ******************** */
$settings-profile-button-bg-color: #2a2a3a;
$settings-subsection-fg-color: $text-secondary-color;
/* ******************** */

/* Room */
/* ******************** */
$room-icon-unread-color: #64748B;
/* ******************** */

/* RoomHeader */
/* ******************** */
$roomheader-addroom-bg-color: rgba(56, 189, 248, 0.15);
$roomheader-addroom-fg-color: $primary-content;
/* ******************** */

/* Rich-text-editor */
/* ******************** */
$pill-bg-color: #38BDF8;
$pill-hover-bg-color: #0EA5E9;
$pill-press-bg-color: #0284C7;
/* ******************** */

/* Inputs */
/* ******************** */
$input-border-color: rgba(148, 163, 184, 0.2);
$input-darker-bg-color: #0C0C12;
$input-darker-fg-color: #64748B;
$input-lighter-bg-color: #1E1E2A;
$input-placeholder: #64748B;
/* ******************** */

/* Dialog */
/* ******************** */
$dialog-title-fg-color: $primary-content;
$dialog-backdrop-color: #00000080;
$dialog-close-fg-color: $icon-button-color;
$dialog-close-external-color: $primary-content;
/* ******************** */

/* RoomList */
/* ******************** */
$roomlist-bg-color: rgba(30, 30, 42, 0.9);
$roomsublist-skeleton-ui-bg: linear-gradient(180deg, #1E1E2A 0%, #1E1E2A00 100%);
$roomtile-default-badge-bg-color: #64748B;
/* ******************** */

/* Tabbed views */
/* ******************** */
$tab-label-fg-color: $secondary-content;
$tab-label-active-fg-color: $primary-content;
/* ******************** */

/* Buttons */
/* ******************** */
$button-primary-fg-color: #0C0C12;
$button-secondary-bg-color: transparent;
$button-danger-fg-color: $primary-content;
$button-danger-disabled-fg-color: $primary-content;
/* ******************** */

/* Toggle switch */
/* ******************** */
$togglesw-off-color: $room-highlight-color;
/* ******************** */

/* Authpage */
/* ******************** */
$authpage-primary-color: $primary-content;
$authpage-modal-content-with-blur-bg-color: rgb(0, 0, 0, 0.59);
/* ******************** */

/* Message action bar */
/* ******************** */
$message-action-bar-bg-color: $header-panel-bg-color;
$message-action-bar-fg-color: $header-panel-text-primary-color;
$message-action-bar-border-color: #334155;
$message-action-bar-hover-border-color: $header-panel-text-primary-color;
/* ******************** */

/* Reaction row */
/* ******************** */
$reaction-row-button-hover-border-color: $header-panel-text-primary-color;
$reaction-row-button-selected-bg-color: #2a2a3a;
/* ******************** */

/* Voice messages */
/* ******************** */
$voice-record-stop-border-color: $quaternary-content;
$voice-record-icon-color: $quaternary-content;
/* ******************** */

/* Bubble tiles */
/* ******************** */
$eventbubble-self-bg: #0c4a6e;
$eventbubble-others-bg: #1e293b;
$eventbubble-bg-hover: #1E1E2A;
/* ******************** */

/* Lightbox */
/* ******************** */
$lightbox-background-bg-color: $menu-border-color;
$lightbox-background-bg-opacity: 0.85;
/* ******************** */

/* VoIP */
/* ******************** */
$call-view-button-on-foreground: $primary-content;
$call-view-button-on-background: $system;
$call-view-button-off-foreground: $system;
$call-view-button-off-background: $primary-content;
$call-view-content-background: $quinary-content;

$video-feed-secondary-background: $system;

$call-system: $system;
$call-background: $background;
$call-primary-content: $primary-content;
$call-light-quaternary-content: #64748B;
/* ******************** */

/* Location sharing */
/* ******************** */
$location-live-color: #38BDF8;
$location-live-secondary-color: #bae6fd;
/* ******************** */

/* Location sharing */
/* ******************** */
.maplibregl-ctrl-attrib-button {
    color: $background;
}
/* ******************** */

/* One-off colors */
/* ******************** */
$progressbar-bg-color: #1e293b;
$kbd-border-color: #334155;
$visual-bell-bg-color: #800;
$event-timestamp-color: #64748B;
$composer-shadow-color: rgba(0, 0, 0, 0.28);
$breadcrumb-placeholder-bg-color: #1e293b;
$resend-button-divider-color: #334155;
$inlinecode-border-color: $quinary-content;
$inlinecode-background-color: $system;
$codeblock-background-color: #1e293b;
$scrollbar-thumb-color: rgba(255, 255, 255, 0.2);
$selected-color: $room-highlight-color;
/* ******************** */

/* blur amounts for left panel */
/* ******************** */
:root {
    --lp-background-blur: 45px;
}
/* ******************** */

body {
    color-scheme: dark;
}

/* Nasty hacks to apply a filter to arbitrary monochrome artwork */
/* ******************** */
.mx_filterFlipColor {
    filter: invert(1);
}
/* ******************** */

/* markdown overrides */
/* ******************** */
.mx_EventTile_content .markdown-body {
    table {
        tr {
            background-color: #0C0C12;
        }

        tr:nth-child(2n) {
            background-color: #080810;
        }
    }
}
/* ******************** */

/* diff highlight colors */
/* ******************** */
.hljs-tag {
    color: inherit;
}

.hljs-addition {
    background: #0c4a6e;
}

.hljs-deletion {
    background: #53232a;
}
/* ******************** */

/* Splash Page Gradient */
.mx_SplashPage::before {
    background-image:
        radial-gradient(53.85% 66.75% at 87.55% 0%, hsla(200deg, 80%, 15%, 0.3) 0%, hsla(200deg, 100%, 88%, 0) 100%),
        radial-gradient(41.93% 41.93% at 0% 0%, hsla(200deg, 50%, 20%, 0.4) 0%, hsla(200deg, 100%, 88%, 0) 100%),
        radial-gradient(100% 100% at 0% 0%, hsla(200deg, 100%, 50%, 0.15) 0%, hsla(200deg, 100%, 86%, 0) 100%),
        radial-gradient(106.35% 96.26% at 100% 0%, hsla(200deg, 100%, 60%, 0.2) 0%, hsla(180deg, 76%, 82%, 0) 100%) !important;
}

/* ******************** */
/* Compound Design Token Overrides */
/* Override the --cpd-color-* CSS custom properties that Compound components use directly */
/* ******************** */
@layer compound.custom {
    :root, [class*="cpd-theme-"] {
        /* Gray scale — navy-tinted */
        --cpd-color-gray-100: #0e0e16;
        --cpd-color-gray-200: #12121c;
        --cpd-color-gray-300: #181824;
        --cpd-color-gray-400: #1e1e2e;
        --cpd-color-gray-500: #2a2a3a;
        --cpd-color-gray-600: #334155;
        --cpd-color-gray-700: #475569;
        --cpd-color-gray-800: #64748B;
        --cpd-color-gray-900: #94A3B8;
        --cpd-color-gray-1000: #94A3B8;
        --cpd-color-gray-1100: #B0BEC5;
        --cpd-color-gray-1200: #CBD5E1;
        --cpd-color-gray-1300: #E2E8F0;
        --cpd-color-gray-1400: #E2E8F0;

        /* Alpha grays */
        --cpd-color-alpha-gray-100: hsla(220, 30%, 70%, 0.01);
        --cpd-color-alpha-gray-200: hsla(220, 30%, 70%, 0.04);
        --cpd-color-alpha-gray-300: hsla(220, 41%, 70%, 0.06);
        --cpd-color-alpha-gray-400: hsla(220, 30%, 70%, 0.1);
        --cpd-color-alpha-gray-500: hsla(220, 30%, 70%, 0.15);
        --cpd-color-alpha-gray-1300: hsla(220, 50%, 95%, 0.89);

        /* Green scale — remapped to sky-blue */
        --cpd-color-green-100: #082f49;
        --cpd-color-green-200: #0c4a6e;
        --cpd-color-green-300: #075985;
        --cpd-color-green-400: #0369a1;
        --cpd-color-green-500: #0284c7;
        --cpd-color-green-600: #0ea5e9;
        --cpd-color-green-700: #38bdf8;
        --cpd-color-green-800: #38bdf8;
        --cpd-color-green-900: #38bdf8;
        --cpd-color-green-1000: #7dd3fc;
        --cpd-color-green-1100: #7dd3fc;
        --cpd-color-green-1200: #bae6fd;
        --cpd-color-green-1300: #e0f2fe;
        --cpd-color-green-1400: #f0f9ff;

        /* Alpha greens — remapped to sky-blue with alpha */
        --cpd-color-alpha-green-100: hsla(199, 89%, 48%, 0.03);
        --cpd-color-alpha-green-200: hsla(199, 89%, 48%, 0.06);
        --cpd-color-alpha-green-300: hsla(199, 89%, 48%, 0.1);
        --cpd-color-alpha-green-400: hsla(199, 89%, 48%, 0.16);
        --cpd-color-alpha-green-500: hsla(199, 89%, 48%, 0.22);

        /* Red scale — muted rose for dark theme */
        --cpd-color-red-100: #1a0a0e;
        --cpd-color-red-200: #200c11;
        --cpd-color-red-300: #2d1018;
        --cpd-color-red-400: #3d1520;
        --cpd-color-red-500: #5c1d2e;
        --cpd-color-red-600: #7a2538;
        --cpd-color-red-700: #9f3344;
        --cpd-color-red-800: #dc4454;
        --cpd-color-red-900: #F87171;
        --cpd-color-red-1000: #FCA5A5;
        --cpd-color-red-1100: #FECACA;
        --cpd-color-red-1200: #FEE2E2;
        --cpd-color-red-1300: #FEF2F2;
        --cpd-color-red-1400: #FFFAFA;

        /* Background tokens */
        --cpd-color-theme-bg: #0C0C12;
        --cpd-color-bg-canvas-default: #0C0C12;
        --cpd-color-bg-subtle-primary: #1E1E2A;
        --cpd-color-bg-subtle-secondary: #1a1a28;
        --cpd-color-bg-action-primary-rest: #38BDF8;
        --cpd-color-bg-action-primary-hovered: #0EA5E9;
        --cpd-color-bg-action-primary-pressed: #0284C7;
        --cpd-color-bg-action-secondary-rest: #0C0C12;
        --cpd-color-bg-action-secondary-hovered: rgba(56, 189, 248, 0.08);
        --cpd-color-bg-action-tertiary-hovered: #1a1a28;
        --cpd-color-bg-action-tertiary-selected: #2a2a3a;
        --cpd-color-bg-accent-rest: #38BDF8;
        --cpd-color-bg-accent-hovered: #7dd3fc;
        --cpd-color-bg-accent-pressed: #bae6fd;
        --cpd-color-bg-accent-selected: hsla(199, 89%, 48%, 0.1);
        --cpd-color-bg-success-subtle: #0c4a6e;
        --cpd-color-bg-critical-primary: #F87171;
        --cpd-color-bg-critical-hovered: #FCA5A5;
        --cpd-color-bg-critical-subtle: #200c11;
        --cpd-color-bg-critical-subtle-hovered: #2d1018;
        --cpd-color-bg-info-subtle: #0c4a6e;
        --cpd-color-bg-badge-accent: hsla(199, 89%, 48%, 0.22);

        /* Text tokens */
        --cpd-color-text-primary: #E2E8F0;
        --cpd-color-text-secondary: #94A3B8;
        --cpd-color-text-action-accent: #38BDF8;
        --cpd-color-text-link-external: #38BDF8;
        --cpd-color-text-critical-primary: #F87171;
        --cpd-color-text-success-primary: #38BDF8;
        --cpd-color-text-info-primary: #38BDF8;
        --cpd-color-text-on-solid-primary: #0C0C12;
        --cpd-color-text-badge-accent: #7dd3fc;

        /* Icon tokens */
        --cpd-color-icon-primary: #E2E8F0;
        --cpd-color-icon-secondary: #94A3B8;
        --cpd-color-icon-tertiary: #64748B;
        --cpd-color-icon-on-solid-primary: #0C0C12;
        --cpd-color-icon-success-primary: #38BDF8;
        --cpd-color-icon-critical-primary: #F87171;
        --cpd-color-icon-accent-tertiary: #38BDF8;
        --cpd-color-icon-accent-primary: #38BDF8;

        /* Border tokens */
        --cpd-color-border-interactive-primary: #334155;
        --cpd-color-border-interactive-secondary: #475569;
        --cpd-color-border-interactive-hovered: #64748B;
        --cpd-color-border-disabled: #1e293b;
        --cpd-color-border-success-subtle: #0284c7;
        --cpd-color-border-accent-subtle: #38bdf8;
        --cpd-color-border-critical-primary: #F87171;
        --cpd-color-border-critical-hovered: #FCA5A5;
        --cpd-color-border-critical-subtle: #5c1d2e;

        /* Username / decorative colors — blue-steel palette */
        --cpd-color-text-decorative-1: #7DD3FC;
        --cpd-color-text-decorative-2: #93C5FD;
        --cpd-color-text-decorative-3: #A5B4FC;
        --cpd-color-text-decorative-4: #BAE6FD;
        --cpd-color-text-decorative-5: #CBD5E1;
        --cpd-color-text-decorative-6: #67E8F9;
    }
}
